# Copy to `.env` and fill in YOUR sheet. Never commit `.env`.
# Public clones without these values cannot write to anyone else's sheet.

# Google Apps Script web app /exec URL (Execute as Me, Who has access: Anyone)
WXT_GOOGLE_WEB_APP_URL=

# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<ID>/edit
WXT_SPREADSHEET_ID=

# Tab name inside that spreadsheet
WXT_SHEET_NAME=LeadBridge
